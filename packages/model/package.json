{
  "name": "@insight/model",
  "version": "0.1.0",
  "description": "Insight: one whole-project model per snapshot, with scopes as views of it and reverse references",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@insight/flow": "workspace:*",
    "@insight/ir": "workspace:*",
    "@insight/sdk": "workspace:*"
  }
}
