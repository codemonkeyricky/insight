{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insight.dev/core/plugin-manifest.json",
  "title": "PluginManifest",
  "description": "insight-plugin.json: what a plugin provides and where its entry points are.",
  "type": "object",
  "required": ["id", "version", "irVersion", "roles"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "irVersion": { "description": "IR version range, for example ^1.0.", "type": "string", "pattern": "^\\^[0-9]+\\.[0-9]+$" },
    "detect": { "description": "Globs. The plugin applies when any project file matches.", "type": "array", "items": { "type": "string", "minLength": 1 } },
    "files": { "description": "Globs of files a frontend extracts one by one. Defaults to detect.", "type": "array", "items": { "type": "string", "minLength": 1 } },
    "inputs": { "description": "Extra input globs. Editing a matching file marks every shard of this plugin dirty.", "type": "array", "items": { "type": "string", "minLength": 1 } },
    "provides": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(structure|packaging|flow|calls|concurrency|sync|effects|x-[a-z0-9-]+)$" },
      "uniqueItems": true
    },
    "dependsOn": { "description": "Plugin ids that must load first.", "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } },
    "kinds": { "description": "Path to a JSON file holding an array of kind definitions.", "type": "string", "minLength": 1 },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "frontend": { "type": "string", "minLength": 1 },
        "lens": { "type": "string", "minLength": 1 },
        "resolver": {
          "type": "object",
          "required": ["scheme", "entry", "priority"],
          "additionalProperties": false,
          "properties": {
            "scheme": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
            "entry": { "type": "string", "minLength": 1 },
            "priority": { "type": "integer" }
          }
        }
      }
    }
  }
}
