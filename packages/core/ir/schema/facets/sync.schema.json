{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insight.dev/ir/facets/sync.json",
  "title": "SyncFacet",
  "description": "Coordination between concurrent things.",
  "$defs": {
    "SyncLockAcquire": { "type": "object", "required": ["lock"], "properties": { "lock": { "type": "string", "minLength": 1 }, "mode": { "enum": ["exclusive", "shared"] } } },
    "SyncLockRelease": { "type": "object", "required": ["lock"], "properties": { "lock": { "type": "string", "minLength": 1 } } },
    "SyncRwlockAcquire": { "type": "object", "required": ["mode"], "properties": { "mode": { "enum": ["shared", "exclusive"] }, "lock": { "type": "string", "description": "mutex name the lock is taken on" } } },
    "SyncSemaphore": { "type": "object", "required": ["op"], "properties": { "op": { "enum": ["acquire", "release", "wait", "notify", "op"], "description": "operation performed" }, "name": { "type": "string" }, "lock": { "type": "string", "description": "lock name the operation is tied to" }, "api": { "type": "string", "description": "exact API name, e.g. Semaphore.acquire" } } },
    "SyncAtomicOp": { "type": "object", "required": ["op"], "properties": { "op": { "enum": ["acquire", "release", "wait", "notify", "op"], "description": "operation performed" }, "lock": { "type": "string", "description": "lock name the operation is tied to" }, "api": { "type": "string", "description": "exact API name, e.g. Atomics.wait" } } },
    "SyncCondvar": { "type": "object", "required": ["op"], "properties": { "op": { "enum": ["acquire", "release", "wait", "notify", "op"], "description": "operation performed" }, "name": { "type": "string", "description": "the condition variable identity, e.g. Class::cv_" }, "lock": { "type": "string", "description": "lock name the operation is tied to" }, "api": { "type": "string", "description": "exact API name, e.g. Condition.wait" } } }
  }
}
