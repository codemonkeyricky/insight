{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insight.dev/ir/facets/packaging.json",
  "title": "PackagingFacet",
  "description": "How code is split and wired together.",
  "$defs": {
    "PackagingBuildTarget": { "type": "object", "required": ["name", "source"], "properties": { "name": { "type": "string", "minLength": 1 }, "label": { "type": "string" }, "targetKind": { "type": "string" }, "output": { "enum": ["executable", "library", "test", "other"] }, "source": { "enum": ["tool", "static"] }, "visibility": { "type": "array", "items": { "type": "string" } } } },
    "PackagingImport": { "type": "object", "required": ["specifier"], "properties": { "specifier": { "type": "string" }, "typeOnly": { "type": "boolean" }, "dynamic": { "type": "boolean" } } },
    "PackagingExport": { "type": "object", "properties": { "name": { "type": "string" } } },
    "PackagingReExport": { "type": "object", "properties": { "specifier": { "type": "string" } } },
    "PackagingInclude": { "type": "object", "properties": { "text": { "type": "string" }, "system": { "type": "boolean" } } },
    "PackagingDepEdge": { "type": "object", "properties": { "scope": { "type": "string" } } },
    "PackagingTargetContains": { "type": "object" },
"PackagingExternal": { "type": "object", "required": ["name", "source", "manager"], "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string" }, "repoName": { "type": "string" }, "manager": { "type": "string", "minLength": 1, "description": "The build or package manager that owns this external package, e.g. bazel, cmake, conan, vcpkg, npm." }, "source": { "type": "string", "minLength": 1, "description": "How the package is obtained. Examples: bzlmod, workspace, lockfile, find_package, FetchContent, pkg-config, vendored." }, "registry": { "type": "string" }, "url": { "type": "string" }, "sha256": { "type": "string" }, "dev": { "type": "boolean" }, "override": { "type": "string", "description": "How a version override is applied. Examples: git, archive, local, single_version, multiple_version." } } }
  }
}
