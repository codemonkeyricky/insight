{
  "name": "@insight/ir",
  "version": "0.1.0",
  "description": "Insight IR: JSON Schemas, generated types, kind registry and validator",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "gen": "node scripts/generate-types.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^16.0.0"
  }
}
