{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Person record",
  "description": "A person with a name and a home address.",
  "type": "object",
  "required": ["name"],
  "properties": {
    "name": { "$ref": "#/definitions/Name" },
    "age": { "type": "integer", "minimum": 0 },
    "address": { "$ref": "./address.schema.json#/definitions/Address" }
  },
  "definitions": {
    "Person": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/definitions/Name" },
        "address": { "$ref": "./address.schema.json#/definitions/Address" },
        "nickname": { "type": "string" }
      }
    },
    "Name": {
      "type": "object",
      "required": ["first", "last"],
      "properties": {
        "first": { "type": "string" },
        "last": { "type": "string" }
      }
    }
  }
}
