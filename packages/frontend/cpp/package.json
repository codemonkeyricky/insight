{
  "name": "@insight/frontend-cpp",
  "version": "0.1.0",
  "description": "Insight frontend: C and C++ via tree-sitter (syntactic)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "data", "insight-plugin.json"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@insight/ir": "workspace:*",
    "@insight/sdk": "workspace:*",
    "tree-sitter-cpp": "0.23.4",
    "web-tree-sitter": "0.27.2"
  }
}
