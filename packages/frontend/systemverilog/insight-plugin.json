{
  "id": "frontend-systemverilog",
  "version": "0.2.3",
  "description": "Verilog and SystemVerilog via tree-sitter (syntactic): structure, instances, includes and imports, control flow, calls, system-task effects. No preprocessing.",
  "irVersion": "^1.0",
  "detect": ["**/*.v", "**/*.sv", "**/*.svh", "**/*.vh"],
  "files": ["**/*.v", "**/*.sv", "**/*.svh", "**/*.vh"],
  "provides": ["calls", "effects", "flow", "packaging", "structure"],
  "kinds": "data/kinds.json",
  "roles": {
    "frontend": "dist/index.js",
    "resolver": {
      "scheme": "sv.include",
      "entry": "dist/resolve.js",
      "priority": 10
    }
  }
}
