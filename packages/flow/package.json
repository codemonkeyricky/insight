{
  "name": "@insight/flow",
  "version": "0.1.0",
  "description": "Insight: rebuilds the control-flow chart of a source file from the IR flow, call and concurrency facts",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@insight/ir": "workspace:*",
    "@insight/sdk": "workspace:*"
  },
  "devDependencies": {
    "@insight/frontend-typescript": "workspace:*"
  }
}
