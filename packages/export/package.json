{
  "name": "@insight/export",
  "version": "0.1.0",
  "description": "Insight: the slim static export of one indexed project (the JSON the static web build reads)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@insight/core": "workspace:*",
    "@insight/sdk": "workspace:*",
    "@insight/server": "workspace:*"
  }
}
