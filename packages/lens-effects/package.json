{
  "name": "@insight/lens-effects",
  "version": "0.1.0",
  "description": "Insight lens: side effects per function, effects reachable from entry points, and forbid rules by module",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "insight-plugin.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@insight/ir": "workspace:*",
    "@insight/sdk": "workspace:*",
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.3"
  }
}
