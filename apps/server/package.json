{
  "name": "@insight/server",
  "version": "0.1.0",
  "description": "Insight local server: project registry, indexing jobs with SSE progress, and the read API for the web app",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "insight-server": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@fastify/static": "^9.0.0",
    "@insight/indexer": "workspace:*",
    "@insight/flow": "workspace:*",
    "@insight/ir": "workspace:*",
    "@insight/lens-dependencies": "workspace:*",
    "@insight/model": "workspace:*",
    "@insight/sdk": "workspace:*",
    "elkjs": "0.12.0",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.5"
  }
}
