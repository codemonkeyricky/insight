{
  "name": "@insight/web",
  "version": "0.1.0",
  "description": "Insight web app: projects, with the Flow, System, Pipeline and Packages tabs",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build:demo": "tsc -p tsconfig.json --noEmit && VITE_STATIC=1 vite build --outDir dist-demo",
    "build:hosted": "tsc -p tsconfig.json --noEmit && VITE_HOSTED=1 vite build --outDir dist-hosted"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "d3-interpolate": "3.0.1",
    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@insight/flow": "workspace:*",
    "@insight/model": "workspace:*",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.0",
    "@types/d3-interpolate": "3.0.4",
    "@types/d3-selection": "3.0.10",
    "@types/d3-zoom": "3.0.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "26.1.0",
    "vite": "8.3.6"
  }
}
