{
  "name": "@insight/web",
  "version": "0.1.0",
  "description": "Insight web app: projects, overview, lens pages with a source panel",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build:demo": "tsc -p tsconfig.json --noEmit && VITE_STATIC=1 vite build --outDir dist-demo"
  },
  "dependencies": {
    "cytoscape": "3.34.4",
    "d3-interpolate": "3.0.1",
    "d3-selection": "3.0.0",
    "d3-transition": "3.0.1",
    "d3-zoom": "3.0.0",
    "elkjs": "0.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@insight/flow": "workspace:*",
    "@insight/lens-dependencies": "workspace:*",
    "@insight/model": "workspace:*",
    "@types/cytoscape": "3.31.0",
    "@types/d3-interpolate": "3.0.4",
    "@types/d3-selection": "3.0.10",
    "@types/d3-transition": "3.0.9",
    "@types/d3-zoom": "3.0.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "vite": "8.3.6"
  }
}
